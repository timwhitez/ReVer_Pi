{
  "name": "reverpi-pi-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Evidence-preserving context projection for Pi: archive-backed exact recall, transactional compaction and a ledgered gateway provider",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-management",
    "evidence"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.0"
  }
}
